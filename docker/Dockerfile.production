FROM node:22-alpine as frontend-build

WORKDIR /build

COPY ../frontend/package*.json ./
RUN npm install

COPY ../frontend ./
RUN npm run build

FROM nginx:1.26-alpine-slim

COPY --from=frontend-build /build/dist  /var/www
COPY frontend/assets/images /var/www/assets/images
COPY frontend/assets/geometry /var/www/assets/geometry

CMD ["nginx", "-g", "daemon off;"]
