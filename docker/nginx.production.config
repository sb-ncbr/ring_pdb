events {
    worker_connections 1024;
}
http {
    include mime.types;

    server {
        server_name ringweb.biodata.ceitec.muni.cz;
        listen 80;

        return 301 https://ringweb.biodata.ceitec.cz$request_uri;
    }

    server {

       server_name ringweb.biodata.ceitec.cz;
       listen 443 ssl;

       http2 on;

       gzip on;
       gzip_types text/plain text/xml text/css application/json application/javascript text/javascript;

       ssl_certificate /etc/fullchain.pem;
       ssl_certificate_key /etc/privkey.pem;
       ssl_protocols TLSv1.3;

       root /var/www/;

       absolute_redirect off;

       location /api {
             if ($request_method = "OPTIONS") {
                add_header "Access-Control-Allow-Origin" "*" always;
                add_header "Access-Control-Allow-Methods" "GET, OPTIONS" always;
                add_header "Access-Control-Allow-Headers" "Content-Type" always;
                add_header "Content-Length" 0;
                add_header "Content-Type" "text/plain";
                return 204;
            }

            add_header "Access-Control-Allow-Origin" "*" always;
            add_header "Access-Control-Allow-Methods" "GET, OPTIONS" always;
            add_header "Access-Control-Allow-Headers" "Content-Type" always;

            proxy_pass http://api:5000/;
            rewrite  ^/api/(.*)  /$1 break;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "Upgrade";
       }
    }
}